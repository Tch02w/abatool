<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>NumberBoxControlChecks</RootNamespace>
    <AssemblyName>WorkbenchNumberBox.ControlChecks</AssemblyName>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <WindowsSdkPackageVersion>10.0.26100.57</WindowsSdkPackageVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.7705" />
    <Compile Include="../../winui/AbaqusTools.WinUI/Controls/WorkbenchNumberBox.cs" Link="WorkbenchNumberBox.cs" />
    <Compile Include="../../winui/AbaqusTools.WinUI/Controls/PlainDecimalFormatter.cs" Link="PlainDecimalFormatter.cs" />
    <Page Include="../../winui/AbaqusTools.WinUI/Controls/WorkbenchNumberBoxResources.xaml" Link="Controls/WorkbenchNumberBoxResources.xaml" />
  </ItemGroup>
</Project>
