<UserControl
    x:Class="AbaqusTools.WinUI.Controls.WorkbenchExplorerHost"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AbaqusTools.WinUI.Controls">

    <UserControl.Resources>
        <local:NonEmptyStringToVisibilityConverter x:Key="NonEmptyStringToVisibilityConverter" />
    </UserControl.Resources>

    <Border
        Background="{ThemeResource LayerFillColorDefaultBrush}"
        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
        BorderThickness="0,0,1,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border
                Padding="12,8"
                Background="{ThemeResource LayerFillColorAltBrush}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1">
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock x:Name="ExplorerTitleText" FontWeight="SemiBold" Text="项目" />
                        <TextBlock
                            x:Name="ExplorerSubtitleText"
                            MaxWidth="180"
                            FontSize="11"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        x:Name="ExplorerPrimaryButton"
                        Grid.Column="1"
                        MinWidth="72"
                        HorizontalContentAlignment="Center"
                        Click="OnPrimaryActionClicked"
                        Visibility="Collapsed" />
                    <Button
                        x:Name="ExplorerRefreshButton"
                        Grid.Column="2"
                        Width="30"
                        Height="30"
                        Padding="0"
                        Click="OnRefreshClicked"
                        ToolTipService.ToolTip="刷新当前浏览内容">
                        <SymbolIcon Symbol="Refresh" />
                    </Button>
                </Grid>
            </Border>

            <AutoSuggestBox
                x:Name="ExplorerSearchBox"
                Grid.Row="1"
                Margin="8,8,8,4"
                QueryIcon="Find"
                PlaceholderText="搜索当前内容"
                TextChanged="OnSearchTextChanged" />

            <Grid Grid.Row="2">
                <TreeView
                    x:Name="ExplorerTree"
                    Padding="5,4"
                    Collapsed="OnNodeCollapsed"
                    DoubleTapped="OnTreeDoubleTapped"
                    Expanding="OnNodeExpanding"
                    SelectionChanged="OnTreeSelectionChanged"
                    SelectionMode="Single">
                    <TreeView.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="34" ColumnSpacing="7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    VerticalAlignment="Center"
                                    FontSize="14"
                                    Glyph="{Binding Content.IconGlyph}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Text="{Binding Content.Title}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        FontSize="10"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="{Binding Content.Subtitle}"
                                        TextTrimming="CharacterEllipsis"
                                        Visibility="{Binding Content.Subtitle, Converter={StaticResource NonEmptyStringToVisibilityConverter}}" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontSize="10"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding Content.Badge}" />
                            </Grid>
                        </DataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>

                <StackPanel
                    x:Name="ExplorerEmptyPanel"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Spacing="7">
                    <FontIcon HorizontalAlignment="Center" Glyph="&#xE8B7;" />
                    <TextBlock
                        x:Name="ExplorerEmptyText"
                        MaxWidth="210"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="当前没有可浏览的内容"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>

            <Border
                x:Name="ExplorerSelectionCard"
                Grid.Row="3"
                Margin="8,4,8,8"
                Padding="10,8"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Visibility="Collapsed">
                <StackPanel Spacing="3">
                    <TextBlock x:Name="ExplorerSelectionTitleText" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ExplorerSelectionSubtitleText"
                        FontSize="11"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        x:Name="ExplorerSelectionStatusText"
                        FontSize="11"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border
                Grid.Row="4"
                Padding="12,7"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <TextBlock
                    x:Name="ExplorerSummaryText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="就绪"
                    TextWrapping="Wrap" />
            </Border>

            <InfoBar
                x:Name="ExplorerErrorInfoBar"
                Grid.RowSpan="5"
                Margin="8,48,8,0"
                VerticalAlignment="Top"
                IsClosable="True"
                IsOpen="False"
                Severity="Error" />
        </Grid>
    </Border>
</UserControl>
