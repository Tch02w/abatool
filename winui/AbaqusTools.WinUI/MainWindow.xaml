<Window
    x:Class="AbaqusTools.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="1"
                    Margin="10,4,0,4"
                    Padding="11,0"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Foreground="{StaticResource AbaqusAccentBrush}" Glyph="&#xE943;" />
                        <TextBlock
                            x:Name="WindowTitleText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Abaqus Workbench — 新建作业" />
                    </StackPanel>
                </Border>

                <MenuBar Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Stretch">
                    <MenuBarItem Title="文件(F)">
                        <MenuFlyoutItem Click="OnNewJobMenuClicked" Text="新建作业" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="OnExitMenuClicked" Text="退出" />
                    </MenuBarItem>
                    <MenuBarItem Title="作业(J)">
                        <MenuFlyoutItem Click="OnQueueMenuClicked" Text="管理队列" />
                        <MenuFlyoutItem Click="OnStartQueueMenuClicked" Text="开始本机队列" />
                        <MenuFlyoutItem Click="OnStopQueueMenuClicked" Text="停止后续调度" />
                    </MenuBarItem>
                    <MenuBarItem Title="服务器(S)">
                        <MenuFlyoutItem Click="OnComputeResourcesMenuClicked" Text="连接 / 配置" />
                        <MenuFlyoutItem Click="OnRefreshResourcesMenuClicked" Text="刷新资源" />
                        <MenuFlyoutItem Click="OnDisconnectServerMenuClicked" Text="断开远端连接" />
                    </MenuBarItem>
                    <MenuBarItem Title="后处理(P)">
                        <MenuFlyoutItem Click="OnPostprocessingMenuClicked" Text="当前作业送入后处理" />
                        <MenuFlyoutItem Click="OnPostprocessingMenuClicked" Text="打开 ODB 后处理" />
                        <MenuFlyoutItem Click="OnResultBrowserMenuClicked" Text="打开结果浏览" />
                    </MenuBarItem>
                </MenuBar>

                <Grid
                    x:Name="TitleBarDragRegion"
                    Grid.Column="3"
                    Background="Transparent" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar
                x:Name="StartupInfoBar"
                Margin="12,8,12,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Title="本地控制面不可用" />

            <NavigationView
                x:Name="ShellNavigation"
                Grid.Row="1"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                PaneDisplayMode="Top"
                SelectionChanged="OnNavigationSelectionChanged">
                <NavigationView.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Invoked="OnPostprocessingAcceleratorInvoked"
                        Key="Number7"
                        Modifiers="Control" />
                    <KeyboardAccelerator
                        Invoked="OnResultBrowserAcceleratorInvoked"
                        Key="Number8"
                        Modifiers="Control" />
                </NavigationView.KeyboardAccelerators>
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NewJobItem" MinWidth="118" HorizontalContentAlignment="Center" Content="新建作业" Tag="new-job">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Add" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="作业队列" Tag="job-queue">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Bullets" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="作业概览" Tag="job-overview">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="View" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="计算资源" Tag="compute-resources">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="重启动链" Tag="restart-chain">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Refresh" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="ODB 合并" Tag="odb-merge">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Copy" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="ODB 后处理" Tag="odb-postprocessing">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="OpenFile" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="结果浏览" Tag="result-browser">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        x:Name="ProjectExplorerRail"
                        Width="260"
                        HorizontalAlignment="Left"
                        Background="{ThemeResource LayerFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,1,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Border
                                Padding="12,7"
                                Background="{ThemeResource LayerFillColorAltBrush}"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,0,0,1">
                                <Grid>
                                    <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="项目" />
                                    <Button
                                        x:Name="ProjectRefreshButton"
                                        Width="30"
                                        Height="30"
                                        HorizontalAlignment="Right"
                                        Padding="0"
                                        Click="OnRefreshProjectExplorerClicked"
                                        ToolTipService.ToolTip="刷新本地项目与队列">
                                        <SymbolIcon Symbol="Refresh" />
                                    </Button>
                                </Grid>
                            </Border>

                            <TreeView
                                x:Name="ProjectTree"
                                Grid.Row="1"
                                Padding="5,8"
                                DoubleTapped="OnProjectTreeDoubleTapped"
                                SelectionMode="Single">
                                <TreeView.RootNodes>
                                    <TreeViewNode x:Name="CurrentProjectNode" Content="当前项目" IsExpanded="True">
                                        <TreeViewNode.Children>
                                            <TreeViewNode x:Name="InputFilesNode" Content="输入文件" IsExpanded="True">
                                                <TreeViewNode.Children>
                                                    <TreeViewNode Content="尚未选择 INP" />
                                                </TreeViewNode.Children>
                                            </TreeViewNode>
                                            <TreeViewNode x:Name="ResultFilesNode" Content="结果文件" IsExpanded="True">
                                                <TreeViewNode.Children>
                                                    <TreeViewNode Content="尚无 ODB 结果" />
                                                </TreeViewNode.Children>
                                            </TreeViewNode>
                                            <TreeViewNode x:Name="JobsNode" Content="作业" IsExpanded="True">
                                                <TreeViewNode.Children>
                                                    <TreeViewNode Content="尚无调度作业" />
                                                </TreeViewNode.Children>
                                            </TreeViewNode>
                                            <TreeViewNode x:Name="MergePlansNode" Content="合并计划" IsExpanded="True">
                                                <TreeViewNode.Children>
                                                    <TreeViewNode Content="尚无重启动合并计划" />
                                                </TreeViewNode.Children>
                                            </TreeViewNode>
                                        </TreeViewNode.Children>
                                    </TreeViewNode>
                                </TreeView.RootNodes>
                            </TreeView>

                            <Border
                                Grid.Row="2"
                                Margin="8,0,8,8"
                                Padding="11,9"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="7">
                                    <TextBlock FontWeight="SemiBold" Text="资源总览" />
                                    <TextBlock
                                        x:Name="ProjectNodeStatusText"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="本机 · 正在检测" />
                                    <TextBlock x:Name="ProjectCpuText" FontSize="12" Text="CPU —" />
                                    <ProgressBar x:Name="ProjectCpuProgress" Height="5" Maximum="100" Value="0" />
                                    <TextBlock x:Name="ProjectMemoryText" FontSize="12" Text="内存 —" />
                                    <ProgressBar x:Name="ProjectMemoryProgress" Height="5" Maximum="100" Value="0" />
                                    <TextBlock x:Name="ProjectJobsText" FontSize="12" Text="作业 0 · 运行 0 · 等待 0" />
                                    <TextBlock
                                        x:Name="ProjectRemoteText"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="远端 · 未连接"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <Border
                                Grid.Row="3"
                                Padding="12,7"
                                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="双击 INP 或 ODB 可载入主界面"
                                    TextWrapping="Wrap" />
                            </Border>
                        </Grid>
                    </Border>

                    <Frame x:Name="ContentFrame" Grid.Column="1" />
                </Grid>
            </NavigationView>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="12,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PageStatusText"
                    VerticalAlignment="Center"
                    Text="就绪"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="LocalResourceStatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="本机 CPU — · 内存 —" />
                <TextBlock
                    x:Name="QueueStatusText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="队列 0 · 运行 0 · 等待 0" />
                <TextBlock
                    x:Name="RemoteStatusText"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="远端 ○ 未连接" />
                <TextBlock
                    x:Name="AbaqusStatusText"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Abaqus ○ 待检测" />
                <TextBlock
                    x:Name="ControlPlaneStatusText"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="控制面 ○ 未连接" />
                <TextBlock
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text=".NET 10 · WinUI 3" />
            </Grid>
        </Border>
    </Grid>
</Window>
