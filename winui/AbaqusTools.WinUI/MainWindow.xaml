<Window
    x:Class="AbaqusTools.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AbaqusTools.WinUI.Controls">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="1"
                    Margin="10,4,0,4"
                    Padding="11,0"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Foreground="{StaticResource AbaqusAccentBrush}" Glyph="&#xE943;" />
                        <TextBlock
                            x:Name="WindowTitleText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Abaqus Workbench — 新建作业" />
                    </StackPanel>
                </Border>

                <MenuBar Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Stretch">
                    <MenuBarItem Title="文件(F)">
                        <MenuFlyoutItem Click="OnNewJobMenuClicked" Text="新建作业" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="OnExitMenuClicked" Text="退出" />
                    </MenuBarItem>
                    <MenuBarItem Title="作业(J)">
                        <MenuFlyoutItem Click="OnQueueMenuClicked" Text="管理队列" />
                        <MenuFlyoutItem Click="OnStartQueueMenuClicked" Text="开始本机队列" />
                        <MenuFlyoutItem Click="OnStopQueueMenuClicked" Text="停止后续调度" />
                    </MenuBarItem>
                    <MenuBarItem Title="服务器(S)">
                        <MenuFlyoutItem Click="OnComputeResourcesMenuClicked" Text="连接 / 配置" />
                        <MenuFlyoutItem Click="OnRefreshResourcesMenuClicked" Text="刷新资源" />
                        <MenuFlyoutItem Click="OnDisconnectServerMenuClicked" Text="断开远端连接" />
                    </MenuBarItem>
                    <MenuBarItem Title="后处理(P)">
                        <MenuFlyoutItem Click="OnPostprocessingMenuClicked" Text="当前作业送入后处理" />
                        <MenuFlyoutItem Click="OnPostprocessingMenuClicked" Text="打开 ODB 后处理" />
                        <MenuFlyoutItem Click="OnResultBrowserMenuClicked" Text="打开结果浏览" />
                    </MenuBarItem>
                </MenuBar>

                <Grid
                    x:Name="TitleBarDragRegion"
                    Grid.Column="3"
                    Background="Transparent" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <InfoBar
                x:Name="StartupInfoBar"
                Margin="12,8,12,0"
                IsClosable="True"
                IsOpen="False"
                Severity="Error"
                Title="本地控制面不可用" />

            <NavigationView
                x:Name="ShellNavigation"
                Grid.Row="1"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                KeyboardAcceleratorPlacementMode="Hidden"
                PaneDisplayMode="Top"
                SelectionChanged="OnNavigationSelectionChanged">
                <NavigationView.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Invoked="OnPostprocessingAcceleratorInvoked"
                        Key="Number7"
                        Modifiers="Control" />
                    <KeyboardAccelerator
                        Invoked="OnResultBrowserAcceleratorInvoked"
                        Key="Number8"
                        Modifiers="Control" />
                </NavigationView.KeyboardAccelerators>
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NewJobItem" MinWidth="118" HorizontalContentAlignment="Center" Content="新建作业" Tag="new-job">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Add" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="作业队列" Tag="job-queue">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Bullets" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="作业概览" Tag="job-overview">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="View" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="计算资源" Tag="compute-resources">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="重启动链" Tag="restart-chain">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Refresh" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="ODB 合并" Tag="odb-merge">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Copy" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="ODB 后处理" Tag="odb-postprocessing">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="OpenFile" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="结果浏览" Tag="result-browser">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:WorkbenchExplorerHost
                        x:Name="ExplorerHost"
                        Width="280"
                        HorizontalAlignment="Stretch" />

                    <Frame x:Name="ContentFrame" Grid.Column="1" />
                </Grid>
            </NavigationView>
        </Grid>

        <Border
            Grid.Row="2"
            Padding="12,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PageStatusText"
                    VerticalAlignment="Center"
                    Text="就绪"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="LocalResourceStatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="本机 CPU — · 内存 —" />
                <TextBlock
                    x:Name="QueueStatusText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="队列 0 · 运行 0 · 等待 0" />
                <TextBlock
                    x:Name="RemoteStatusText"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="远端 ○ 未连接" />
                <TextBlock
                    x:Name="AbaqusStatusText"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Abaqus ○ 待检测" />
                <TextBlock
                    x:Name="ControlPlaneStatusText"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="控制面 ○ 未连接" />
                <TextBlock
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text=".NET 10 · WinUI 3" />
            </Grid>
        </Border>
    </Grid>
</Window>
