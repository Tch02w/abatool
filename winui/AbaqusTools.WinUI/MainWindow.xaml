<Window
    x:Class="AbaqusTools.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AbaqusTools.WinUI.Controls">

    <Grid
        Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
        Loaded="OnRootLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="38" />
            <RowDefinition Height="*" />
            <RowDefinition Height="32" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="TitleBarLeftInsetColumn" Width="0" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="TitleBarRightInsetColumn" Width="0" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="1"
                    Margin="10,4,0,4"
                    Padding="11,0"
                    VerticalAlignment="Stretch"
                    Background="{ThemeResource ControlFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="7">
                        <FontIcon FontSize="13" Foreground="{StaticResource AbaqusAccentBrush}" Glyph="&#xE943;" />
                        <TextBlock
                            x:Name="WindowTitleText"
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Text="Abaqus Workbench — 新建作业" />
                    </StackPanel>
                </Border>

                <MenuBar x:Name="WindowMenuBar" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Stretch">
                    <FlyoutBase.AttachedFlyout>
                        <Flyout x:Name="JobNotificationFlyout" Placement="BottomEdgeAlignedRight"
                                Opened="OnNotificationFlyoutOpened" Closed="OnNotificationFlyoutClosed">
                            <StackPanel Width="470" Spacing="10">
                                <TextBlock x:Name="NotificationListTitle" Text="未读提醒" FontWeight="SemiBold" />
                                <TextBlock x:Name="NotificationMessageText" TextWrapping="Wrap" />
                                <ListView x:Name="JobNotificationList" MaxHeight="360" SelectionMode="None">
                                    <ListView.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Spacing="5" Margin="0,4,0,12" Width="424">
                                                <TextBlock Text="{Binding Heading}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding RecordedTime}" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding WorkDirectory}" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <Button Content="查看作业" Tag="{Binding}" Click="OnOpenNotifiedJobClicked" />
                                                    <Button Content="标为已读" Tag="{Binding}" Click="OnReadNotificationClicked" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                                <Button x:Name="ReadNotificationPageButton" Content="本页全部已读" Click="OnReadNotificationPageClicked" />
                            </StackPanel>
                        </Flyout>
                    </FlyoutBase.AttachedFlyout>
                    <MenuBarItem Title="文件(F)">
                        <MenuFlyoutItem Click="OnNewJobMenuClicked" Text="新建作业" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Click="OnExitMenuClicked" Text="退出" />
                    </MenuBarItem>
                    <MenuBarItem Title="作业(J)">
                        <MenuFlyoutItem Click="OnQueueMenuClicked" Text="管理队列" />
                        <MenuFlyoutItem x:Name="StartQueueMenuItem" IsEnabled="False" Click="OnStartQueueMenuClicked" Text="开始本机队列" />
                        <MenuFlyoutItem x:Name="StopQueueMenuItem" IsEnabled="False" Click="OnStopQueueMenuClicked" Text="停止后续调度" />
                        <MenuFlyoutItem x:Name="TerminateQueueMenuItem" IsEnabled="False" Click="OnTerminateQueueMenuClicked" Text="终止所选运行中作业…" />
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem x:Name="JobNotificationsMenuItem" Click="OnOpenNotificationCenter" Text="结束提醒" />
                    </MenuBarItem>
                    <MenuBarItem Title="服务器(S)">
                        <MenuFlyoutItem Click="OnComputeResourcesMenuClicked" Text="连接 / 配置" />
                        <MenuFlyoutItem x:Name="RefreshRemoteMenuItem" IsEnabled="False" Click="OnRefreshResourcesMenuClicked" Text="刷新远端资源" />
                        <MenuFlyoutItem x:Name="DisconnectRemoteMenuItem" IsEnabled="False" Click="OnDisconnectServerMenuClicked" Text="断开远端连接" />
                    </MenuBarItem>
                    <MenuBarItem Title="后处理(P)">
                        <MenuFlyoutItem x:Name="CurrentJobPostprocessingMenuItem" Click="OnCurrentJobPostprocessingMenuClicked" Text="当前作业送入后处理" />
                        <MenuFlyoutItem Click="OnPostprocessingMenuClicked" Text="打开 ODB 后处理" />
                        <MenuFlyoutItem Click="OnResultBrowserMenuClicked" Text="打开结果浏览" />
                    </MenuBarItem>
                </MenuBar>

                <Grid
                    x:Name="TitleBarDragRegion"
                    Grid.Column="3"
                    Background="Transparent" />
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <NavigationView
                x:Name="ShellNavigation"
                IsBackButtonVisible="Collapsed"
                IsPaneToggleButtonVisible="False"
                IsSettingsVisible="False"
                IsTitleBarAutoPaddingEnabled="False"
                KeyboardAcceleratorPlacementMode="Hidden"
                PaneDisplayMode="Top"
                SelectionChanged="OnNavigationSelectionChanged">
                <NavigationView.KeyboardAccelerators>
                    <KeyboardAccelerator
                        Invoked="OnExplorerAcceleratorInvoked"
                        Key="B"
                        Modifiers="Control" />
                    <KeyboardAccelerator
                        Invoked="OnPostprocessingAcceleratorInvoked"
                        Key="Number7"
                        Modifiers="Control" />
                    <KeyboardAccelerator
                        Invoked="OnResultBrowserAcceleratorInvoked"
                        Key="Number8"
                        Modifiers="Control" />
                </NavigationView.KeyboardAccelerators>
                <NavigationView.MenuItems>
                    <NavigationViewItem x:Name="NewJobItem" MinWidth="118" HorizontalContentAlignment="Center" Content="新建作业" Tag="new-job">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Add" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="作业队列" Tag="job-queue">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Bullets" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="作业概览" Tag="job-overview">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="View" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="计算资源" Tag="compute-resources">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Repair" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="重启动链" Tag="restart-chain">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Refresh" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="ODB 合并" Tag="odb-merge">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Copy" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="ODB 后处理" Tag="odb-postprocessing">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="OpenFile" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem MinWidth="118" HorizontalContentAlignment="Center" Content="结果浏览" Tag="result-browser">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Pictures" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ExplorerColumn" Width="280" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <controls:WorkbenchExplorerHost
                        x:Name="ExplorerHost"
                        CollapseRequested="OnExplorerToggleClicked"
                        Width="280"
                        HorizontalAlignment="Stretch" />

                    <Border x:Name="ExplorerCollapsedRail" Visibility="Collapsed"
                            Background="{ThemeResource LayerFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,1,0" />

                    <Button x:Name="ExplorerToggleButton" Width="30" Height="30"
                            MinWidth="30" MinHeight="30" Padding="0" Margin="0,8,5,0" Visibility="Collapsed"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                            Click="OnExplorerToggleClicked"
                            AutomationProperties.Name="显示浏览侧栏"
                            ToolTipService.ToolTip="显示浏览侧栏 (Ctrl+B)">
                        <FontIcon FontFamily="{ThemeResource SymbolThemeFontFamily}"
                                  FontSize="16" Width="16" Height="16" Glyph="&#xE76C;" />
                    </Button>

                    <Frame x:Name="ContentFrame" Grid.Column="1" />
                </Grid>
            </NavigationView>
            <controls:WorkbenchFeedbackHost x:Name="FeedbackHost" Margin="12"
                                           HorizontalAlignment="Right" VerticalAlignment="Bottom" />
        </Grid>

        <Border
            Grid.Row="2"
            Padding="12,0"
            Background="{ThemeResource LayerFillColorDefaultBrush}"
            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
            BorderThickness="0,1,0,0">
            <Grid ColumnSpacing="18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="PageStatusText"
                    VerticalAlignment="Center"
                    Text="就绪"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="LocalResourceStatusText"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="本机 CPU — · 内存 —" />
                <TextBlock
                    x:Name="QueueStatusText"
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="队列 0 · 运行 0 · 等待 0" />
                <TextBlock
                    x:Name="RemoteStatusText"
                    Grid.Column="3"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="远端 ○ 未连接" />
                <TextBlock
                    x:Name="AbaqusStatusText"
                    Grid.Column="4"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="Abaqus ○ 待检测" />
                <TextBlock
                    x:Name="ControlPlaneStatusText"
                    Grid.Column="5"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="控制面 ○ 未连接" />
                <TextBlock
                    Grid.Column="6"
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text=".NET 10 · WinUI 3" />
            </Grid>
        </Border>
    </Grid>
</Window>
