<Page
    x:Class="AbaqusTools.WinUI.Pages.ComputeResourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,20,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="ResourceInfoBar" IsOpen="False" IsClosable="True" />

        <Grid Grid.Row="1" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource WorkbenchCardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4">
                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="本机状态" />
                        <TextBlock x:Name="LocalStatusText" FontSize="20" FontWeight="SemiBold" Text="等待实时数据" />
                    </StackPanel>
                    <FontIcon Grid.Column="1" FontSize="24" Foreground="{StaticResource AbaqusMutedBrush}" Glyph="&#xE770;" />
                </Grid>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource WorkbenchCardStyle}">
                <StackPanel Spacing="7">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="本机 CPU" />
                    <TextBlock x:Name="CpuSummaryText" FontSize="20" FontWeight="SemiBold" Text="— / — 线程" />
                    <ProgressBar x:Name="CpuProgress" Maximum="100" Value="0" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource WorkbenchCardStyle}">
                <StackPanel Spacing="7">
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="已保存服务器" />
                    <TextBlock x:Name="RemoteSummaryText" FontSize="20" FontWeight="SemiBold" Text="0 个配置" />
                    <TextBlock x:Name="RemoteConnectionText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="当前未连接" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" MinWidth="600" />
                <ColumnDefinition Width="*" MinWidth="310" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource WorkbenchCardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock Style="{StaticResource WorkbenchSectionTitleStyle}" Text="资源节点" />
                            <TextBlock x:Name="QueueSummaryText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="队列作业：0" />
                        </StackPanel>
                        <Button x:Name="RefreshButton" Grid.Column="1" Click="OnRefreshClicked" Content="刷新所选资源" />
                        <Button x:Name="AddServerButton" Grid.Column="2" Click="OnAddServerClicked" Style="{StaticResource AccentButtonStyle}" Content="添加服务器" />
                        <Button x:Name="ConnectButton" Grid.Column="3" Click="OnConnectClicked" Content="连接" IsEnabled="False" />
                        <Button x:Name="EditButton" Grid.Column="4" Click="OnEditServerClicked" Content="编辑配置" IsEnabled="False" />
                    </Grid>

                    <ListView
                        x:Name="ResourceList"
                        Grid.Row="1"
                        ItemsSource="{x:Bind ResourceNodes}"
                        SelectionChanged="OnResourceSelectionChanged"
                        SelectionMode="Single">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,10" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="150" />
                                        <ColumnDefinition Width="170" />
                                        <ColumnDefinition Width="105" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="2">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock FontSize="11" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding Endpoint}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{Binding StatusDisplay}" />
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{Binding CpuDisplay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding MemoryDisplay}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding QueueDisplay}" />
                                    <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{Binding ComputeRoot}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource WorkbenchCardStyle}">
                <Grid RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Style="{StaticResource WorkbenchSectionTitleStyle}" Text="所选资源详情" />
                    <StackPanel Grid.Row="1" Spacing="4">
                        <TextBlock x:Name="DetailNameText" FontSize="20" FontWeight="SemiBold" Text="请选择资源" />
                        <TextBlock x:Name="DetailEndpointText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="—" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <Grid ColumnSpacing="12" RowSpacing="10">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="90" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource WorkbenchFieldLabelStyle}" Text="连接状态" /><TextBlock x:Name="DetailStatusText" Grid.Column="1" Text="未选择" />
                            <TextBlock Grid.Row="1" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="CPU" /><TextBlock x:Name="DetailCpuText" Grid.Row="1" Grid.Column="1" Text="未获取" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="内存" /><TextBlock x:Name="DetailMemoryText" Grid.Row="2" Grid.Column="1" Text="未获取" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="3" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="运行 / 等待" /><TextBlock x:Name="DetailQueueText" Grid.Row="3" Grid.Column="1" Text="0 / 0" />
                            <TextBlock Grid.Row="4" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="计算目录" /><TextBlock x:Name="DetailRootText" Grid.Row="4" Grid.Column="1" Text="尚未获取" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="5" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="Abaqus" /><TextBlock x:Name="DetailAbaqusText" Grid.Row="5" Grid.Column="1" Text="本机配置" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="6" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="主机指纹" /><TextBlock x:Name="DetailFingerprintText" Grid.Row="6" Grid.Column="1" Text="—" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="7" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="更新时间" /><TextBlock x:Name="DetailUpdatedText" Grid.Row="7" Grid.Column="1" Text="—" />
                            <TextBlock Grid.Row="8" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="活动作业" /><TextBlock x:Name="DetailJobsText" Grid.Row="8" Grid.Column="1" Text="无" TextWrapping="Wrap" />
                        </Grid>
                    </ScrollViewer>
                    <StackPanel Grid.Row="3" Spacing="8">
                        <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Button x:Name="BrowseFilesButton" HorizontalAlignment="Stretch" Click="OnBrowseRemoteFilesClicked" Content="浏览 / 下载" IsEnabled="False" />
                            <Button x:Name="UploadFileButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnUploadRemoteFileClicked" Content="上传文件" IsEnabled="False" />
                        </Grid>
                        <StackPanel x:Name="TransferPanel" Spacing="6" Visibility="Collapsed">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="TransferStatusText" Text="文件传输" TextTrimming="CharacterEllipsis" />
                                <Button x:Name="CancelTransferButton" Grid.Column="1" Click="OnCancelTransferClicked" Content="取消" />
                            </Grid>
                            <ProgressBar x:Name="TransferProgressBar" Maximum="100" Value="0" />
                        </StackPanel>
                        <Button x:Name="DisconnectButton" HorizontalAlignment="Stretch" Click="OnDisconnectClicked" Content="断开远端连接" IsEnabled="False" />
                        <Button x:Name="DeleteButton" HorizontalAlignment="Stretch" Click="OnDeleteServerClicked" Content="删除服务器配置" IsEnabled="False" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
