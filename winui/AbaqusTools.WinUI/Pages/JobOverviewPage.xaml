<Page
    x:Class="AbaqusTools.WinUI.Pages.JobOverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,20,24,24" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource WorkbenchCardStyle}"><StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="状态" /><TextBlock x:Name="StatusSummaryText" Margin="0,6,0,0" FontSize="20" FontWeight="SemiBold" Text="未运行" /><TextBlock x:Name="ArchiveStatusText" Margin="0,4,0,0" FontSize="12" TextWrapping="Wrap" Visibility="Collapsed" /></StackPanel></Border>
            <Border Grid.Column="1" Style="{StaticResource WorkbenchCardStyle}"><StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="进度" /><TextBlock x:Name="ProgressSummaryText" Margin="0,6,0,0" FontSize="20" FontWeight="SemiBold" Text="—" /></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource WorkbenchCardStyle}"><StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="运行时间" /><TextBlock x:Name="ElapsedSummaryText" Margin="0,6,0,0" FontSize="20" FontWeight="SemiBold" Text="00:00:00" /></StackPanel></Border>
            <Border Grid.Column="3" Style="{StaticResource WorkbenchCardStyle}"><StackPanel><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="内存占用" /><TextBlock x:Name="MemorySummaryText" Margin="0,6,0,0" FontSize="20" FontWeight="SemiBold" Text="—" /></StackPanel></Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource WorkbenchCardStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="Job" />
                    <ComboBox x:Name="JobSelector" Grid.Column="1" Width="260" DisplayMemberPath="DisplayName" IsEnabled="False" PlaceholderText="尚无作业" SelectionChanged="OnJobSelectionChanged" />
                    <TextBlock x:Name="OverviewMessageText" Grid.Column="2" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="正在等待队列数据…" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="JobStatsText" Grid.Column="3" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="运行中 0 · 完成 0 · 异常 0" />
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="6">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock x:Name="CurrentJobTitleText" VerticalAlignment="Center" FontSize="18" FontWeight="SemiBold" Text="Job: 未选择" />
                    <Button x:Name="OpenDirectoryButton" Grid.Column="1" Click="OnOpenDirectoryClicked" Content="目录" IsEnabled="False" /><Button x:Name="OpenStaButton" Grid.Column="2" Click="OnOpenOutputFileClicked" Content="STA" IsEnabled="False" Tag=".sta" />
                    <Button x:Name="OpenMsgButton" Grid.Column="3" Click="OnOpenOutputFileClicked" Content="MSG" IsEnabled="False" Tag=".msg" /><Button x:Name="OpenDatButton" Grid.Column="4" Click="OnOpenOutputFileClicked" Content="DAT" IsEnabled="False" Tag=".dat" />
                    <Button x:Name="PauseResumeButton" Grid.Column="5" Click="OnPauseResumeClicked" Content="暂停" IsEnabled="False" /><Button x:Name="TerminateButton" Grid.Column="6" Click="OnTerminateClicked" Content="终止" IsEnabled="False" />
                </Grid>
                <ProgressBar x:Name="RuntimeProgressBar" Grid.Row="2" Maximum="100" Value="0" />
                <Grid Grid.Row="3" ColumnSpacing="18">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <StackPanel Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="输入文件" /><TextBlock x:Name="InputPathText" Text="未记录" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <StackPanel Grid.Column="1" Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="工作目录" /><TextBlock x:Name="WorkDirectoryText" Text="尚未分配" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <StackPanel Grid.Column="2" Spacing="4"><TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="重启动依赖" /><TextBlock x:Name="RestartDependencyText" Text="无" /></StackPanel>
                </Grid>
                <Grid Grid.Row="4" Margin="0,4,0,0">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <TextBlock Style="{StaticResource WorkbenchSectionTitleStyle}" Text="STA / MSG / DAT 运行日志" />
                        <TextBlock x:Name="RuntimeLogUpdateText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="有新日志，取消文字选择后显示" Visibility="Collapsed" />
                    </StackPanel>
                    <TextBox x:Name="RuntimeLogTextBox" Grid.Row="1" Margin="0,8,0,0" AcceptsReturn="True" FontFamily="Consolas" IsReadOnly="True" Text="选择作业后显示实时运行日志。" TextWrapping="NoWrap" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
