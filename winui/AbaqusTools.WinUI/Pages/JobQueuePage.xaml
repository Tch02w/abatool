<Page
    x:Class="AbaqusTools.WinUI.Pages.JobQueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,20,24,24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource WorkbenchCardStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <InfoBar x:Name="QueueInfoBar" IsClosable="False" IsOpen="True" Message="候选区与正式队列已接入；本机求解进程控制正在继续迁移。" Severity="Informational" />
                <Grid Grid.Row="1" ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource WorkbenchSectionTitleStyle}" Text="候选区" />
                    <Button x:Name="AddCurrentInputButton" Grid.Column="1" Click="OnAddCurrentInputClicked" Content="加入当前 INP…" />
                    <Button x:Name="AddCandidateFilesButton" Grid.Column="2" Click="OnAddCandidateFilesClicked" Content="添加 INP…" />
                    <Button x:Name="ScanCandidateFolderButton" Grid.Column="3" Click="OnScanCandidateFolderClicked" Content="扫描文件夹…" />
                    <Button Grid.Column="4" Click="OnSelectAllCandidatesClicked" Content="全选" />
                    <Button Grid.Column="5" Click="OnInvertCandidatesClicked" Content="反选" />
                    <Button Grid.Column="6" Click="OnRemoveCandidatesClicked" Content="移除" />
                    <Button Grid.Column="7" Click="OnConfirmCandidatesClicked" Content="确认入队" Style="{StaticResource AccentButtonStyle}" />
                    <StackPanel Grid.Column="8" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="CandidateSummaryText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="候选：0 · 已选 0 · 异常 0" />
                        <Button x:Name="RefreshQueueButton" Click="OnRefreshClicked" Content="刷新" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <CheckBox x:Name="RecursiveScanCheckBox" Content="扫描子文件夹" />
                    <CheckBox x:Name="SkipRestartNamesCheckBox" Grid.Column="1" Content="跳过 Restart 文件" />
                    <CheckBox x:Name="SkipExistingResultsCheckBox" Grid.Column="2" Content="跳过已有结果的作业" />
                    <TextBlock Grid.Column="3" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="SSD 与归档目录可在编辑作业时设置" />
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="8,0" Background="{ThemeResource LayerFillColorAltBrush}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="55" /><ColumnDefinition Width="150" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="100" /><ColumnDefinition Width="130" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="勾选" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="序号" />
                        <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="作业名称" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="INP 文件路径" />
                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="加入方式" /><TextBlock Grid.Column="5" VerticalAlignment="Center" Text="作业类型" />
                        <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="重启动依赖" /><TextBlock Grid.Column="7" VerticalAlignment="Center" Text="检查结果" />
                    </Grid>
                    <ListView x:Name="CandidateList" Grid.Row="1" SelectionMode="Multiple">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,7" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="50" /><ColumnDefinition Width="55" /><ColumnDefinition Width="150" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="110" /><ColumnDefinition Width="100" /><ColumnDefinition Width="130" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                    <CheckBox HorizontalAlignment="Center" IsChecked="{Binding Selected, Mode=OneWay}" Click="OnCandidateCheckClicked" /><TextBlock Grid.Column="1" Text="{Binding Index}" />
                                    <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="{Binding JobName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="3" Text="{Binding InpPath}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="4" Text="{Binding Source}" /><TextBlock Grid.Column="5" Text="{Binding JobType}" />
                                    <TextBlock Grid.Column="6" Text="{Binding OldjobName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="7" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <StackPanel x:Name="CandidateEmptyPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Spacing="5">
                        <FontIcon FontSize="26" Glyph="&#xE8F1;" />
                        <TextBlock Text="尚无候选作业" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource WorkbenchCardStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource WorkbenchSectionTitleStyle}" Text="正式队列" />
                    <TextBlock x:Name="FormalQueueSummaryText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="队列：0" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <TextBlock VerticalAlignment="Center" Text="同名结果" />
                        <ComboBox x:Name="ExistingResultPolicyComboBox" Width="126" SelectedIndex="0">
                            <ComboBoxItem Content="备份旧结果" Tag="backup" />
                            <ComboBoxItem Content="覆盖旧结果" Tag="overwrite" />
                            <ComboBoxItem Content="取消该作业" Tag="cancel" />
                        </ComboBox>
                        <TextBlock VerticalAlignment="Center" Text="并行上限" />
                        <NumberBox x:Name="ParallelLimitNumberBox" Width="100" Minimum="1" Maximum="999" SpinButtonPlacementMode="Inline" Value="1" />
                    </StackPanel>
                </Grid>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="StartQueueButton" Click="OnStartQueueClicked" Content="开始队列" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="StopQueueButton" Click="OnStopQueueClicked" Content="停止调度" />
                    <Button x:Name="TerminateQueueItemsButton" Click="OnTerminateQueueItemsClicked" Content="终止运行中" />
                    <Button Click="OnEditQueueItemClicked" Content="编辑" />
                    <Button Click="OnHoldQueueItemsClicked" Content="暂停调度" />
                    <Button Click="OnResumeQueueItemsClicked" Content="恢复调度" />
                    <Button Click="OnRequeueItemsClicked" Content="重新排队" />
                    <Button Click="OnMoveQueueItemUpClicked" Content="上移" />
                    <Button Click="OnMoveQueueItemDownClicked" Content="下移" />
                    <Button Click="OnRemoveQueueItemsClicked" Content="移除" />
                    <Button Click="OnClearFinishedClicked" Content="清理完成记录" />
                </StackPanel>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid Padding="8,0" Background="{ThemeResource LayerFillColorAltBrush}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="55" /><ColumnDefinition Width="145" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="125" /><ColumnDefinition Width="70" /><ColumnDefinition Width="85" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="100" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center" Text="序号" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="作业名称" /><TextBlock Grid.Column="2" VerticalAlignment="Center" Text="INP 文件路径" />
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="作业类型" /><TextBlock Grid.Column="4" VerticalAlignment="Center" Text="重启动依赖" /><TextBlock Grid.Column="5" VerticalAlignment="Center" Text="Core" />
                        <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="内存" /><TextBlock Grid.Column="7" VerticalAlignment="Center" Text="优先级" /><TextBlock Grid.Column="8" VerticalAlignment="Center" Text="调度" />
                        <TextBlock Grid.Column="9" VerticalAlignment="Center" Text="状态" /><TextBlock Grid.Column="10" VerticalAlignment="Center" Text="备注" />
                    </Grid>
                    <ListView x:Name="FormalQueueList" Grid.Row="1" SelectionMode="Multiple" DoubleTapped="OnFormalQueueDoubleTapped">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="8,7" ColumnSpacing="8">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="55" /><ColumnDefinition Width="145" /><ColumnDefinition Width="3*" /><ColumnDefinition Width="100" /><ColumnDefinition Width="125" /><ColumnDefinition Width="70" /><ColumnDefinition Width="85" /><ColumnDefinition Width="90" /><ColumnDefinition Width="90" /><ColumnDefinition Width="100" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Index}" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding JobName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="2" Text="{Binding InpPath}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="3" Text="{Binding JobType}" /><TextBlock Grid.Column="4" Text="{Binding OldjobName}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="5" Text="{Binding CoresDisplay}" />
                                    <TextBlock Grid.Column="6" Text="{Binding RuntimeMemoryDisplay}" /><TextBlock Grid.Column="7" Text="{Binding PriorityDisplay}" /><TextBlock Grid.Column="8" Text="{Binding SchedulingDisplay}" />
                                    <TextBlock Grid.Column="9" FontWeight="SemiBold" Text="{Binding Status}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="10" Text="{Binding Message}" TextTrimming="CharacterEllipsis" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <TextBlock x:Name="FormalQueueEmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Text="尚无正式队列作业" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
