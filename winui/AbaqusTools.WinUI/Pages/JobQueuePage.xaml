<Page
    x:Class="AbaqusTools.WinUI.Pages.JobQueuePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AbaqusTools.WinUI.Controls">

    <Grid Padding="{StaticResource WorkbenchPagePadding}" RowSpacing="{StaticResource WorkbenchSectionSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Style="{StaticResource WorkbenchCardStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Style="{StaticResource WorkbenchSectionTitleStyle}" Text="候选区" />
                    <Button x:Name="AddCurrentInputButton" Grid.Column="1" Click="OnAddCurrentInputClicked" Content="加入当前 INP…" />
                    <Button x:Name="AddCandidateFilesButton" Grid.Column="2" Click="OnAddCandidateFilesClicked" Content="添加 INP…" />
                    <Button x:Name="ScanCandidateFolderButton" Grid.Column="3" Click="OnScanCandidateFolderClicked" Content="扫描文件夹…" />
                    <Button Grid.Column="4" Click="OnSelectAllCandidatesClicked" Content="全选" />
                    <Button Grid.Column="5" Click="OnInvertCandidatesClicked" Content="反选" />
                    <Button Grid.Column="6" Click="OnRemoveCandidatesClicked" Content="移除" />
                    <Button Grid.Column="7" Click="OnConfirmCandidatesClicked" Content="确认入队" Style="{StaticResource AccentButtonStyle}" />
                    <StackPanel Grid.Column="8" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
                        <TextBlock x:Name="CandidateSummaryText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <Button x:Name="RefreshQueueButton" Click="OnRefreshClicked" Content="刷新" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="1" ColumnSpacing="14">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <CheckBox x:Name="RecursiveScanCheckBox" Content="扫描子文件夹" />
                    <CheckBox x:Name="SkipRestartNamesCheckBox" Grid.Column="1" Content="跳过 Restart 文件" />
                    <CheckBox x:Name="SkipExistingResultsCheckBox" Grid.Column="2" Content="跳过已有结果的作业" />
                    <StackPanel Grid.Column="3" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="6">
                        <Button x:Name="EditCandidateButton" Content="编辑候选" Click="OnEditCandidateClicked"
                                ToolTipService.ToolTip="编辑当前选中的一行候选作业" />
                        <Button x:Name="CandidateDirectoriesButton" Content="批量设置目录…" Click="OnCandidateDirectoriesClicked"
                                ToolTipService.ToolTip="设置已勾选候选作业的计算与归档目录" />
                    </StackPanel>
                </Grid>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <controls:QueueTableView x:Name="CandidateTable" Grid.RowSpan="2" Kind="Candidate"
                                             CandidateCheckClicked="OnCandidateCheckClicked" />
                    <StackPanel x:Name="CandidateEmptyPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Spacing="5">
                        <FontIcon FontSize="26" Glyph="&#xE8F1;" />
                        <TextBlock Text="尚无候选作业" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="1" Style="{StaticResource WorkbenchCardStyle}">
            <Grid RowSpacing="10">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource WorkbenchSectionTitleStyle}" Text="正式队列" />
                        <Button x:Name="TerminateEntireQueueButton" IsEnabled="False" VerticalAlignment="Center"
                                Click="OnTerminateEntireQueueClicked" Content="终止整个队列…" />
                    </StackPanel>
                    <TextBlock x:Name="FormalQueueSummaryText" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="正在读取队列…" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock VerticalAlignment="Center" Text="同名结果" />
                        <ComboBox x:Name="ExistingResultPolicyComboBox" Width="126" Height="40" VerticalAlignment="Center" VerticalContentAlignment="Center" SelectedIndex="0">
                            <ComboBoxItem Content="备份旧结果" Tag="backup" />
                            <ComboBoxItem Content="覆盖旧结果" Tag="overwrite" />
                            <ComboBoxItem Content="取消该作业" Tag="cancel" />
                        </ComboBox>
                        <TextBlock VerticalAlignment="Center" Text="并行上限" />
                        <controls:ParameterHelpButton Title="队列并行上限" Topic="queue-parallel" VerticalAlignment="Center" />
                        <controls:WorkbenchNumberBox x:Name="ParallelLimitNumberBox" FrameAppearance="ComboBox" Width="160" VerticalAlignment="Center" Minimum="1" Maximum="999" SpinButtonPlacementMode="Inline" Value="1" />
                    </StackPanel>
                </Grid>
                <StackPanel x:Name="FormalQueueActionBar" Grid.Row="1" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="StartQueueButton" Click="OnStartQueueClicked" Content="开始队列" Style="{StaticResource AccentButtonStyle}" />
                    <Button x:Name="StopQueueButton" Click="OnStopQueueClicked" Content="停止调度" />
                    <Button x:Name="TerminateQueueItemsButton" Click="OnTerminateQueueItemsClicked" Content="终止所选…" />
                    <Button Click="OnEditQueueItemClicked" Content="编辑" />
                    <Button Click="OnHoldQueueItemsClicked" Content="暂停调度" />
                    <Button Click="OnResumeQueueItemsClicked" Content="恢复调度" />
                    <Button Click="OnRequeueItemsClicked" Content="重新排队" />
                    <Button Click="OnMoveQueueItemUpClicked" Content="上移" />
                    <Button Click="OnMoveQueueItemDownClicked" Content="下移" />
                    <Button Click="OnRemoveQueueItemsClicked" Content="移除" />
                    <Button Click="OnClearFinishedClicked" Content="清理完成记录" />
                </StackPanel>
                <Grid x:Name="ExternalJobScanBar" Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center" Text="工作目录：" />
                    <TextBox x:Name="ExternalWorkDirTextBox" Grid.Column="1" PlaceholderText="输入或选择外部 Abaqus 作业工作目录" />
                    <Button x:Name="ChooseExternalWorkDirButton" Grid.Column="2" Width="88" HorizontalContentAlignment="Center" Click="OnChooseExternalWorkDirClicked" Content="浏览…" />
                    <Button x:Name="ScanExternalJobsButton" Grid.Column="3" Width="88" HorizontalContentAlignment="Center" Click="OnScanExternalJobsClicked" Content="扫描" Style="{StaticResource AccentButtonStyle}" />
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions><RowDefinition Height="34" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <controls:QueueTableView x:Name="FormalTable" Grid.RowSpan="2" Kind="Formal" />
                    <TextBlock x:Name="FormalQueueEmptyText" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Text="尚无正式队列作业" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Page>
