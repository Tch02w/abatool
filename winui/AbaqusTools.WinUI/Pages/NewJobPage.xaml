<Page
    x:Class="AbaqusTools.WinUI.Pages.NewJobPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AbaqusTools.WinUI.Controls">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Padding="24,20,24,28" Spacing="12">
            <InfoBar
                x:Name="DraftInfoBar"
                IsClosable="False"
                IsOpen="True"
                Message="本机队列、上传至服务器和服务器现有文件三种执行方式均已接入。"
                Severity="Informational"
                Title="功能接入状态" />

            <Border Style="{StaticResource WorkbenchCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource WorkbenchSectionTitleStyle}" Text="作业输入" />
                    <Grid ColumnSpacing="10" RowSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="108" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="InputPickerColumn" Width="138" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock Style="{StaticResource WorkbenchFieldLabelStyle}" Text="作业名" />
                        <TextBox x:Name="JobNameTextBox" Grid.Column="1" Grid.ColumnSpan="2" PlaceholderText="选择 INP 后自动生成，也可手动修改" />
                        <TextBlock Grid.Row="1" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="输入文件" />
                        <TextBox x:Name="InputPathTextBox" Grid.Row="1" Grid.Column="1" PlaceholderText="选择本机 INP 文件" />
                        <Button x:Name="ChooseInputButton" Grid.Row="1" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnChooseInputClicked" Content="选择 INP…" Style="{StaticResource WorkbenchPickerButtonStyle}" />
                        <TextBlock Grid.Row="2" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="依赖 ODB" />
                        <TextBox x:Name="OldjobPathTextBox" Grid.Row="2" Grid.Column="1" PlaceholderText="可选：上一阶段作业 ODB" />
                        <Button x:Name="ChooseOldjobButton" Grid.Row="2" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnChooseOldjobClicked" Content="选择 ODB…" Style="{StaticResource WorkbenchPickerButtonStyle}" />
                        <TextBlock Grid.Row="3" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="用户子程序" />
                        <TextBox x:Name="FortranPathTextBox" Grid.Row="3" Grid.Column="1" PlaceholderText="可选：Fortran 用户子程序" />
                        <Button x:Name="ChooseFortranButton" Grid.Row="3" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnChooseFortranClicked" Content="选择 FOR…" Style="{StaticResource WorkbenchPickerButtonStyle}" />
                        <TextBlock Grid.Row="4" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="执行策略" />
                        <ComboBox x:Name="ExecutionLocationComboBox" Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" SelectionChanged="OnExecutionLocationChanged" SelectedIndex="0">
                            <ComboBoxItem Content="本机计算" />
                            <ComboBoxItem Content="上传至已连接服务器" />
                            <ComboBoxItem Content="使用服务器现有文件" />
                        </ComboBox>
                        <TextBlock Grid.Row="5" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="计算与归档" />
                        <CheckBox x:Name="UseSsdCheckBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="2" Checked="OnUseSsdChanged" Content="使用 SSD 目录计算" Unchecked="OnUseSsdChanged" />
                        <TextBlock Grid.Row="6" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="SSD 工作目录" />
                        <TextBox x:Name="CalculationRootTextBox" Grid.Row="6" Grid.Column="1" IsEnabled="False" PlaceholderText="启用 SSD 计算后选择" />
                        <Button x:Name="ChooseCalculationRootButton" Grid.Row="6" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnChooseCalculationRootClicked" Content="选择目录…" IsEnabled="False" Style="{StaticResource WorkbenchPickerButtonStyle}" />
                        <TextBlock Grid.Row="7" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="结果归档目录" />
                        <TextBox x:Name="ArchiveRootTextBox" Grid.Row="7" Grid.Column="1" IsEnabled="False" PlaceholderText="可选：计算完成后归档结果" />
                        <Button x:Name="ChooseArchiveRootButton" Grid.Row="7" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnChooseArchiveRootClicked" Content="选择目录…" IsEnabled="False" Style="{StaticResource WorkbenchPickerButtonStyle}" />
                        <TextBlock Grid.Row="8" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="远端服务器" />
                        <TextBlock x:Name="RemoteServerStatusText" Grid.Row="8" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="选择远端执行方式后检查连接" />
                        <Button Grid.Row="8" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnOpenResourcesClicked" Content="管理服务器…" />
                    </Grid>
                    <TextBlock
                        x:Name="PathDecisionText"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="尚未选择 INP，无法判定工作目录与完成归档路径。"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource WorkbenchCardStyle}">
                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource WorkbenchSectionTitleStyle}" Text="执行环境与资源" />
                    <Grid x:Name="ResourceGrid" ColumnSpacing="28" RowSpacing="12" SizeChanged="OnResourceGridSizeChanged">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="ResourceSecondColumn" Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid ColumnSpacing="10" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource WorkbenchFieldLabelStyle}" Text="Abaqus 命令" />
                            <TextBox x:Name="AbaqusCommandTextBox" Grid.Column="1" MinHeight="40" VerticalContentAlignment="Center" Text="abaqus.bat" LostFocus="OnAbaqusCommandLostFocus" />
                            <TextBlock Grid.Row="1" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="内存" />
                            <Grid Grid.Row="1" Grid.Column="1" ColumnSpacing="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="80" /></Grid.ColumnDefinitions>
                                <TextBox x:Name="MemoryValueTextBox" MinHeight="40" VerticalContentAlignment="Center" Text="90" />
                                <ComboBox x:Name="MemoryUnitComboBox" Grid.Column="1" MinHeight="40" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" SelectedIndex="0">
                                    <ComboBoxItem Content="%" />
                                    <ComboBoxItem Content="MB" />
                                    <ComboBoxItem Content="GB" />
                                </ComboBox>
                            </Grid>
                        </Grid>
                        <Grid x:Name="ResourceSecondaryFields" Grid.Column="1" ColumnSpacing="10" RowSpacing="12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="108" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource WorkbenchFieldLabelStyle}" Text="CPU" />
                                <controls:ParameterHelpButton Title="CPU" Topic="cpu" />
                            </StackPanel>
                            <controls:WorkbenchNumberBox x:Name="CpuNumberBox" Grid.Column="1" VerticalAlignment="Center" Minimum="0" Maximum="1" SpinButtonPlacementMode="Inline" Value="1" />
                            <TextBlock Grid.Row="1" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="优先级" />
                            <ComboBox x:Name="PriorityComboBox" Grid.Row="1" Grid.Column="1" MinHeight="40" HorizontalAlignment="Stretch" VerticalContentAlignment="Center" SelectedIndex="0">
                                <ComboBoxItem Content="普通" />
                                <ComboBoxItem Content="高" />
                                <ComboBoxItem Content="低" />
                            </ComboBox>
                        </Grid>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource WorkbenchCardStyle}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource WorkbenchSectionTitleStyle}" Text="运行选项" />
                        <StackPanel Orientation="Horizontal" Spacing="18">
                            <CheckBox x:Name="InteractiveCheckBox" Content="交互输出" />
                            <CheckBox x:Name="DatacheckCheckBox" Content="仅数据检查" />
                            <CheckBox x:Name="NotifyCheckBox" Content="结束提醒" IsChecked="True" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock VerticalAlignment="Center" Text="本地队列并行上限" />
                            <controls:ParameterHelpButton Title="本地队列并行上限" Topic="queue-parallel" />
                            <controls:WorkbenchNumberBox x:Name="MaxParallelNumberBox" Width="160" Minimum="1" SpinButtonPlacementMode="Inline" Value="1" />
                        </StackPanel>
                    </StackPanel>
                    <Button x:Name="PreviewButton" Grid.Column="1" MinWidth="148" VerticalAlignment="Bottom" Click="OnPreviewClicked" Content="预览提交命令" />
                    <Button x:Name="SubmitButton" Grid.Column="2" MinWidth="190" VerticalAlignment="Bottom" Click="OnSubmitClicked" Content="提交作业（加入队列）" Style="{StaticResource AccentButtonStyle}" />
                </Grid>
            </Border>

            <Expander
                x:Name="CommandPreviewExpander"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                Header="命令预览"
                IsExpanded="False">
                <TextBox
                    x:Name="CommandPreviewTextBox"
                    AcceptsReturn="True"
                    FontFamily="Consolas"
                    HorizontalAlignment="Stretch"
                    IsReadOnly="True"
                    MinHeight="124"
                    MinWidth="0"
                    Text="选择有效的 INP 后生成 Abaqus 命令。"
                    TextWrapping="Wrap" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
