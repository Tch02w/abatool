<Page
    x:Class="AbaqusTools.WinUI.Pages.OdbPostprocessingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AbaqusTools.WinUI.Controls">

    <Grid Padding="{StaticResource WorkbenchPagePadding}" RowSpacing="{StaticResource WorkbenchSectionSpacing}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border
            Padding="{StaticResource WorkbenchCardPadding}"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBox
                    x:Name="RootTextBox"
                    Header="ODB 根目录"
                    KeyDown="OnRootTextBoxKeyDown"
                    PlaceholderText="选择包含待处理 ODB 的工程目录" />
                <Button
                    x:Name="BrowseButton"
                    Grid.Column="1"
                    Margin="0,24,0,0"
                    Click="OnBrowseClicked"
                    Content="选择文件夹"
                    Style="{StaticResource WorkbenchPickerButtonStyle}" />
                <Button
                    x:Name="DiscoverButton"
                    Grid.Column="2"
                    Margin="0,24,0,0"
                    Click="OnDiscoverClicked"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing x:Name="DiscoveryProgress" Width="16" Height="16" IsActive="False"
                            Visibility="Collapsed" Foreground="{Binding Foreground, ElementName=DiscoverButton}" />
                        <TextBlock x:Name="DiscoverButtonText" Text="发现 ODB" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button
                    x:Name="OpenResultsButton"
                    Grid.Column="3"
                    Margin="0,24,0,0"
                    Click="OnOpenResultsClicked"
                    Content="打开结果浏览"
                    IsEnabled="False" />
                <CheckBox
                    x:Name="RecursiveCheckBox"
                    Grid.Row="1"
                    Margin="0,8,0,0"
                    Content="递归扫描子目录"
                    IsChecked="True" />
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="2"
                    Grid.ColumnSpan="2"
                    Margin="0,8,0,0"
                    Orientation="Horizontal"
                    Spacing="8">
                    <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="并行 Abaqus 进程" />
                    <controls:ParameterHelpButton Title="并行 Abaqus 进程" Topic="postprocess-parallel" />
                    <controls:WorkbenchNumberBox x:Name="ParallelWorkersNumberBox" Width="160" Minimum="1" SpinButtonPlacementMode="Inline" Value="2" />
                </StackPanel>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="ErrorInfoBar" IsClosable="True" IsOpen="False" Severity="Error" Title="操作失败" />
            <InfoBar x:Name="WarningInfoBar" IsClosable="True" IsOpen="False" Severity="Warning" Title="操作提示" />
            <InfoBar x:Name="WorkspaceRecoveryInfoBar" IsClosable="False" IsOpen="False" Severity="Warning" Title="发现后处理恢复草稿">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <Button x:Name="RestoreWorkspaceDraftButton" Content="恢复编辑" Click="OnRestoreWorkspaceDraftClicked" />
                    <Button x:Name="PreviewWorkspaceDraftButton" Content="查看草稿" Click="OnPreviewWorkspaceDraftClicked" />
                    <Button x:Name="PreserveWorkspaceDraftButton" Content="保留副本并忽略" Click="OnPreserveWorkspaceDraftClicked" />
                </StackPanel>
            </InfoBar>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.1*" MinWidth="560" />
                <ColumnDefinition Width="1*" MinWidth="380" MaxWidth="460" />
            </Grid.ColumnDefinitions>

            <Border
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid Padding="16,11" Background="{ThemeResource LayerFillColorDefaultBrush}" ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="源文件与处理计划" />
                            <TextBlock x:Name="ResultCountText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 个" />
                            <TextBlock x:Name="SelectionCountText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="已选择 0 / 0" />
                            <TextBlock x:Name="DiscoveryMetadataText" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="尚未扫描" />
                        </StackPanel>
                        <Button x:Name="SelectAllButton" Grid.Column="1" Click="OnSelectAllClicked" Content="全选" IsEnabled="False" />
                        <Button x:Name="SelectNoneButton" Grid.Column="2" Click="OnSelectNoneClicked" Content="全不选" IsEnabled="False" />
                        <Button x:Name="InvertSelectionButton" Grid.Column="3" Click="OnInvertSelectionClicked" Content="反选" IsEnabled="False" />
                    </Grid>

                    <Grid Grid.Row="1" Padding="16,10" Background="{ThemeResource LayerFillColorAltBrush}" ColumnSpacing="8">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox x:Name="ForceRescanCheckBox" VerticalAlignment="Center" Content="本次强制重扫" IsEnabled="False" />
                        <Button x:Name="CompatibilityCheckButton" Grid.Column="1" Click="OnCompatibilityCheckClicked" Content="检查兼容性" IsEnabled="False" />
                        <Button x:Name="AnalyzeButton" Grid.Column="2" Click="OnAnalyzeClicked" Content="读取结构与默认参数" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                        <StackPanel Grid.Column="3" Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="CompatibilityStatusText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="尚未运行兼容性检查" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="CompatibilityProgressText" Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 / 0" />
                            </Grid>
                            <ProgressBar x:Name="CompatibilityProgress" Height="4" Maximum="1" Value="0" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0" Spacing="6">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button x:Name="UpgradeButton" Click="OnUpgradeClicked" Content="升级所选 ODB…" IsEnabled="False" />
                                <Button x:Name="RecoverUpgradeButton" Click="OnRecoverUpgradeClicked" Content="恢复／查看升级" />
                                <Button x:Name="CancelUpgradeButton" Click="OnCancelUpgradeClicked" Content="安全停止升级" IsEnabled="False" Visibility="Collapsed" />
                            </StackPanel>
                            <TextBlock x:Name="UpgradeStatusText" Text="旧版 ODB 请先检查兼容性，再确认备份并升级。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressBar x:Name="UpgradeProgress" Visibility="Collapsed" Height="4" IsIndeterminate="False" />
                            <Expander x:Name="UpgradeDetailsExpander" Header="升级详情与逐文件结果" Visibility="Collapsed" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                                <TextBox x:Name="UpgradeDetailsTextBox" Height="150" IsReadOnly="True" AcceptsReturn="True" TextWrapping="NoWrap" />
                            </Expander>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <ListView
                            x:Name="OdbList"
                            IsItemClickEnabled="False"
                            IsMultiSelectCheckBoxEnabled="True"
                            SelectionChanged="OnOdbSelectionChanged"
                            SelectionMode="Multiple">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
                            </ListView.ItemContainerStyle>
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,9" ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="1.5*" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="110" />
                                            <ColumnDefinition Width="1.7*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="{Binding ComparisonGroup}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding SizeDisplay}" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding CompatibilityStatusDisplay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding CompatibilityMessage}" />
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding PostprocessStatusDisplay}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{Binding PostprocessSummary}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding PostprocessSummary}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
                            <FontIcon HorizontalAlignment="Center" FontSize="32" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8B7;" />
                            <TextBlock x:Name="EmptyStateTitle" HorizontalAlignment="Center" FontSize="16" FontWeight="SemiBold" Text="尚未发现 ODB" />
                            <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="选择目录并运行发现。" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="12">
                    <Border Padding="{StaticResource WorkbenchCardPadding}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="选择与对比组" />
                            <TextBlock x:Name="SelectedPlanText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="选择 ODB 后可编辑参数" TextWrapping="Wrap" />
                            <Button x:Name="StructureBrowserButton" Content="浏览实例、集合与可用输出…" HorizontalAlignment="Stretch" Click="OnStructureBrowserClicked" IsEnabled="False" />
                            <Button x:Name="GroupOrderButton" Content="组内排序…" HorizontalAlignment="Stretch" Click="OnGroupOrderClicked" />
                            <Grid ColumnSpacing="6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="CreateGroupsButton" Content="新建对比组…" HorizontalAlignment="Stretch" Click="OnCreateGroupsClicked" />
                                <Button x:Name="ManageGroupsButton" Grid.Column="1" Content="重命名 / 删除…" HorizontalAlignment="Stretch" Click="OnManageGroupsClicked" />
                            </Grid>
                            <TextBox x:Name="GroupNameTextBox" Header="对比组名称" PlaceholderText="多个组用分号分隔" Text="对比组 1" />
                            <ComboBox x:Name="GroupOperationComboBox" Header="对选中 ODB 的分组操作" HorizontalAlignment="Stretch" SelectedIndex="0">
                                <ComboBoxItem Content="替换分组" Tag="replace" />
                                <ComboBoxItem Content="追加到分组（保留已有组）" Tag="add" />
                                <ComboBoxItem Content="从指定分组移除" Tag="remove" />
                                <ComboBoxItem Content="取消全部分组（不删除文件）" Tag="clear" />
                            </ComboBox>
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="ApplyGroupButton" HorizontalAlignment="Stretch" Click="OnApplyGroupClicked" Content="应用分组" IsEnabled="False" />
                                <Button x:Name="ConfigureButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnConfigureClicked" Content="编辑提取参数" IsEnabled="False" />
                                <Button x:Name="LegendButton" Grid.Column="2" HorizontalAlignment="Stretch" Click="OnLegendClicked" Content="图例范围" IsEnabled="False" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Expander
                        x:Name="OutputSettingsExpander"
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        Header="输出与计算设置"
                        IsExpanded="True">
                        <StackPanel Padding="{StaticResource WorkbenchCardPadding}" Spacing="10">
                            <CheckBox x:Name="FullTimehistoryCheckBox" Content="全部帧执行 FreeBodyCut（耗时较长）" />
                            <Grid x:Name="OutputSettingsGrid" MinWidth="0" ColumnSpacing="10" RowSpacing="8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <ComboBox x:Name="RebarMethodComboBox" Grid.ColumnSpan="2" Header="纵筋力计算方法" SelectedIndex="0"
                                          ToolTipService.ToolTip="所选方法参与总轴力计算。复核历史插值结果请选择旧版插值；两种方法不能直接视为相同结果。">
                                    <ComboBoxItem Content="截面单元切割（推荐）" Tag="element_cut" />
                                    <ComboBoxItem Content="旧版插值（历史结果复核）" Tag="legacy_interpolation" />
                                </ComboBox>
                                <controls:WorkbenchNumberBox x:Name="ExpectedRebarCountNumberBox" Grid.Row="1" Grid.ColumnSpan="2" Header="预期纵筋数（0=自动）" Minimum="0" Maximum="10000" SpinButtonPlacementMode="Inline" Value="0" />
                                <ComboBox x:Name="ImageUnitComboBox" Grid.Row="2" Header="图像尺寸单位" SelectionChanged="OnImageUnitChanged" SelectedIndex="0">
                                    <ComboBoxItem Content="像素 px" Tag="px" />
                                    <ComboBoxItem Content="毫米 mm" Tag="mm" />
                                </ComboBox>
                                <controls:WorkbenchNumberBox x:Name="RebarToleranceNumberBox" Grid.Row="2" Grid.Column="1" Header="纵筋切面容差（mm）" Minimum="0" Maximum="100" SpinButtonPlacementMode="Inline" />
                                <controls:WorkbenchNumberBox x:Name="ImageWidthNumberBox" Grid.Row="3" Header="图像宽度" Minimum="320" Maximum="4096" SpinButtonPlacementMode="Inline" Value="1500" />
                                <controls:WorkbenchNumberBox x:Name="ImageHeightNumberBox" Grid.Row="3" Grid.Column="1" Header="图像高度" Minimum="320" Maximum="4096" SpinButtonPlacementMode="Inline" Value="1000" />
                                <ComboBox x:Name="AnimationTimingModeComboBox" Grid.Row="4" Header="GIF 播放方式" SelectedIndex="0" SelectionChanged="OnAnimationTimingModeChanged">
                                    <ComboBoxItem Content="统一帧率" Tag="fps" />
                                    <ComboBoxItem Content="统一时长" Tag="duration" />
                                </ComboBox>
                                <controls:WorkbenchNumberBox x:Name="AnimationFpsNumberBox" Grid.Row="4" Grid.Column="1" Header="动画帧率（帧/秒）" Minimum="1" Maximum="60" SpinButtonPlacementMode="Inline" Value="25" />
                                <controls:WorkbenchNumberBox x:Name="AnimationDurationNumberBox" Grid.Row="4" Grid.Column="1" Header="单轮时长（秒）" Minimum="0.01" SmallChange="0.1" SpinButtonPlacementMode="Inline" Value="4" Visibility="Collapsed" />
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <CheckBox x:Name="WhiteBackgroundCheckBox" Content="白底 PNG" IsChecked="True" />
                                <CheckBox x:Name="TransparentBackgroundCheckBox" Content="透明底 PNG" IsChecked="True" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Border Padding="{StaticResource WorkbenchCardPadding}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Text="执行" />
                            <TextBlock x:Name="PostprocessPhaseText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="读取结构并完成配置后即可运行" TextWrapping="Wrap" />
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <ProgressBar x:Name="PostprocessProgress" Height="6" Maximum="100" Value="0" />
                                <TextBlock x:Name="PostprocessPercentText" Grid.Column="1" VerticalAlignment="Center" Text="0%" />
                            </Grid>
                            <ComboBox x:Name="RunScopeComboBox" Header="运行范围" HorizontalAlignment="Stretch"
                                      PlaceholderText="请选择运行范围" SelectionChanged="OnRunScopeChanged" />
                            <TextBlock x:Name="RunScopePreviewText" TextWrapping="Wrap" MaxLines="3" TextTrimming="CharacterEllipsis"
                                       Style="{StaticResource CaptionTextBlockStyle}" />
                            <Grid ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Button x:Name="RunPostprocessButton" HorizontalAlignment="Stretch" Click="OnRunPostprocessClicked" Content="运行后处理" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                                <Button x:Name="CancelPostprocessButton" Grid.Column="1" HorizontalAlignment="Stretch" Click="OnCancelPostprocessClicked" Content="停止当前操作" IsEnabled="False" />
                            </Grid>
                            <Button x:Name="RecoverPostprocessButton" HorizontalAlignment="Stretch" Click="OnRecoverPostprocessClicked" Content="查询原操作状态" IsEnabled="False" Visibility="Collapsed" />
                            <StackPanel x:Name="GroupQueuePanel" Spacing="6" Visibility="Collapsed">
                                <TextBlock x:Name="GroupQueueSummary" TextWrapping="Wrap" />
                                <TextBlock x:Name="GroupQueueEditHint" Text="工作区改动用于新任务。已排队组的成员、参数和图例可在“编辑等待组”中修改或同步。" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                <ComboBox x:Name="GroupQueueEntries" Header="提取队列" HorizontalAlignment="Stretch" SelectionChanged="OnGroupQueueSelectionChanged" />
                                <TextBlock x:Name="GroupQueueDetail" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
                                <Grid ColumnSpacing="6" RowSpacing="6">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Button x:Name="EditQueuedGroupButton" Content="编辑等待组…" HorizontalAlignment="Stretch" Click="OnEditQueuedGroupClicked" />
                                    <Button x:Name="ClearQueuedGroupsButton" Grid.Column="1" Content="清空待办" HorizontalAlignment="Stretch" Click="OnClearQueuedGroupsClicked" />
                                    <Button x:Name="QueryGroupQueueButton" Grid.Row="1" Content="刷新队列状态" HorizontalAlignment="Stretch" Click="OnQueryGroupQueueClicked" />
                                    <Button x:Name="ResumeGroupQueueButton" Grid.Row="1" Grid.Column="1" Content="继续等待组" HorizontalAlignment="Stretch" Click="OnResumeGroupQueueClicked" />
                                </Grid>
                                <Button x:Name="StopGroupQueueButton" Content="停止整个队列…" HorizontalAlignment="Stretch" Click="OnStopGroupQueueClicked" />
                            </StackPanel>
                            <Button x:Name="CancelCompatibilityButton" HorizontalAlignment="Stretch" Click="OnCancelCompatibilityClicked" Content="取消兼容性检查" IsEnabled="False" Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Expander
            x:Name="PostprocessLogExpander"
            Grid.Row="3"
            HorizontalAlignment="Stretch"
            HorizontalContentAlignment="Stretch"
            Header="运行日志"
            IsExpanded="True">
            <TextBox
                x:Name="PostprocessLogTextBox"
                Height="118"
                MinWidth="0"
                HorizontalAlignment="Stretch"
                AcceptsReturn="True"
                FontFamily="Consolas"
                FontSize="12"
                IsReadOnly="True"
                PlaceholderText="预扫描、缓存命中、提取、渲染和索引消息会显示在这里。"
                TextWrapping="NoWrap" />
        </Expander>
    </Grid>
</Page>
