<Page
    x:Class="AbaqusTools.WinUI.Pages.RestartChainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="24,20,24,24" RowSpacing="12">
        <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource WorkbenchCardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Style="{StaticResource WorkbenchSectionTitleStyle}" Text="依赖拓扑" />
                        <TextBlock x:Name="ChainSummaryText" Grid.Column="1" VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 条链 · 0 个作业" />
                        <Button x:Name="RefreshButton" Grid.Column="2" Margin="8,0,0,0" Click="OnRefreshClicked" Content="刷新依赖" />
                        <Button Grid.Column="3" Margin="8,0,0,0" Click="OnRefreshClicked" Content="校验全部" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <InfoBar x:Name="ChainInfoBar" Grid.Row="1" IsClosable="False" IsOpen="True" Message="正式队列中尚无包含 oldjob 的真实作业。" Severity="Informational" Title="没有重启动依赖" />
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Grid Padding="8,0" Background="{ThemeResource LayerFillColorAltBrush}" ColumnSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="180" /><ColumnDefinition Width="50" /><ColumnDefinition Width="180" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="阶段" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Text="作业" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="" /><TextBlock Grid.Column="3" VerticalAlignment="Center" Text="前置作业" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="校验状态" /><TextBlock Grid.Column="5" VerticalAlignment="Center" Text="ODB / INP 路径" />
                        </Grid>
                        <ListView x:Name="ChainList" Grid.Row="1" SelectionChanged="OnChainSelectionChanged" SelectionMode="Single">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8,8" ColumnSpacing="8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition Width="180" /><ColumnDefinition Width="50" /><ColumnDefinition Width="180" /><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StageDisplay}" /><TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding JobName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="2" HorizontalAlignment="Center" Text="{Binding ArrowDisplay}" /><TextBlock Grid.Column="3" Text="{Binding ParentJobName}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Grid.Column="4" Text="{Binding ValidationStatusDisplay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding ValidationMessage}" />
                                        <TextBlock Grid.Column="5" Text="{Binding PathDisplay}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel x:Name="EmptyChainPanel" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Spacing="8">
                            <FontIcon FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8D7;" />
                             <TextBlock FontSize="16" Text="正式队列中尚无重启动依赖" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="每个阶段可查看来源路径、提交顺序与失败传播。" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12">
                <Border Style="{StaticResource WorkbenchCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource WorkbenchSectionTitleStyle}" Text="链路检查" />
                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource WorkbenchFieldLabelStyle}" Text="循环依赖" /><TextBlock x:Name="CycleCheckText" Grid.Column="1" Text="尚未检查" />
                            <TextBlock Grid.Row="1" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="缺失父作业" /><TextBlock x:Name="MissingCheckText" Grid.Row="1" Grid.Column="1" Text="尚未检查" />
                            <TextBlock Grid.Row="2" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="路径兼容性" /><TextBlock x:Name="PathCheckText" Grid.Row="2" Grid.Column="1" Text="尚未检查" />
                            <TextBlock Grid.Row="3" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="提交顺序" /><TextBlock x:Name="OrderCheckText" Grid.Row="3" Grid.Column="1" Text="尚未生成" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource WorkbenchCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource WorkbenchSectionTitleStyle}" Text="所选阶段" />
                        <TextBlock x:Name="SelectedStageText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="选择依赖节点后显示作业名、前置作业、输入文件、预期 ODB 与状态传播。" TextWrapping="Wrap" />
                        <Button x:Name="EditDependencyButton" HorizontalAlignment="Stretch" Click="OnEditDependencyClicked" Content="编辑依赖" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="LocateInQueueButton" HorizontalAlignment="Stretch" Click="OnLocateInQueueClicked" Content="在队列中定位" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
