<Page
    x:Class="AbaqusTools.WinUI.Pages.RestartChainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Padding="{StaticResource WorkbenchPagePadding}" RowSpacing="{StaticResource WorkbenchSectionSpacing}">
        <Grid.RowDefinitions><RowDefinition Height="*" /></Grid.RowDefinitions>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="3*" /><ColumnDefinition Width="2*" /></Grid.ColumnDefinitions>
            <Border Style="{StaticResource WorkbenchCardStyle}">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center" Spacing="2">
                            <TextBlock Style="{StaticResource WorkbenchSectionTitleStyle}" Text="依赖拓扑 · 重启动计算图谱" />
                            <TextBlock x:Name="ChainSummaryText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="0 条链 · 0 个节点 · 0 个重启动作业" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button x:Name="ZoomOutButton" Grid.Column="1" Margin="8,0,0,0" Click="OnZoomOutClicked" Content="−" ToolTipService.ToolTip="缩小" />
                        <Button x:Name="ZoomInButton" Grid.Column="2" Margin="6,0,0,0" Click="OnZoomInClicked" Content="＋" ToolTipService.ToolTip="放大" />
                        <Button x:Name="RefreshButton" Grid.Column="3" Margin="8,0,0,0" Click="OnRefreshClicked" Content="刷新依赖" />
                        <Button Grid.Column="4" Margin="8,0,0,0" Click="OnRefreshClicked" Content="校验全部" Style="{StaticResource AccentButtonStyle}" />
                    </Grid>
                    <Grid Grid.Row="1" Background="{ThemeResource LayerFillColorDefaultBrush}">
                        <ScrollViewer x:Name="RestartGraphScrollViewer" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                      ZoomMode="Enabled" MinZoomFactor="0.65" MaxZoomFactor="1.5">
                            <Canvas x:Name="RestartGraphCanvas" MinWidth="860" MinHeight="520" Background="Transparent" />
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyChainPanel" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" Spacing="8">
                            <FontIcon FontSize="34" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8D7;" />
                             <TextBlock FontSize="16" Text="正式队列中尚无重启动依赖" />
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="加入带 oldjob 的作业后，将按计算依赖显示分支图谱。" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <StackPanel Grid.Column="1" Spacing="12">
                <Border Style="{StaticResource WorkbenchCardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Style="{StaticResource WorkbenchSectionTitleStyle}" Text="链路检查" />
                        <Grid ColumnSpacing="10" RowSpacing="8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="130" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Style="{StaticResource WorkbenchFieldLabelStyle}" Text="循环依赖" /><TextBlock x:Name="CycleCheckText" Grid.Column="1" Text="尚未检查" />
                            <TextBlock Grid.Row="1" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="缺失父作业" /><TextBlock x:Name="MissingCheckText" Grid.Row="1" Grid.Column="1" Text="尚未检查" />
                            <TextBlock Grid.Row="2" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="路径兼容性" /><TextBlock x:Name="PathCheckText" Grid.Row="2" Grid.Column="1" Text="尚未检查" />
                            <TextBlock Grid.Row="3" Style="{StaticResource WorkbenchFieldLabelStyle}" Text="提交顺序" /><TextBlock x:Name="OrderCheckText" Grid.Row="3" Grid.Column="1" Text="尚未生成" />
                        </Grid>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource WorkbenchCardStyle}">
                    <StackPanel Spacing="10">
                        <TextBlock Style="{StaticResource WorkbenchSectionTitleStyle}" Text="所选阶段" />
                        <TextBlock x:Name="SelectedStageText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="选择依赖节点后显示作业名、前置作业、输入文件、预期 ODB 与状态传播。" TextWrapping="Wrap" />
                        <Button x:Name="GenerateFullResultButton" HorizontalAlignment="Stretch" Click="OnGenerateFullResultClicked" Content="生成此节点完整结果" IsEnabled="False" Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="EditDependencyButton" HorizontalAlignment="Stretch" Click="OnEditDependencyClicked" Content="编辑依赖" IsEnabled="False" />
                        <Button x:Name="LocateInQueueButton" HorizontalAlignment="Stretch" Click="OnLocateInQueueClicked" Content="在队列中定位" IsEnabled="False" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
