<Page
    x:Class="AbaqusTools.WinUI.Pages.ResultBrowserPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AbaqusTools.WinUI.Controls">

    <Grid Padding="28" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Padding="16"
            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBox
                    x:Name="RootTextBox"
                    Header="结果根目录"
                    KeyDown="OnRootTextBoxKeyDown"
                    PlaceholderText="例如 G:\Projects\Abaqus\AbaqusODBPostProcessor_Results" />
                <Button
                    x:Name="BrowseButton"
                    Grid.Column="1"
                    Margin="0,24,0,0"
                    Click="OnBrowseClicked"
                    Content="选择文件夹"
                    Style="{StaticResource WorkbenchPickerButtonStyle}" />
                <Button
                    x:Name="RefreshScopesButton"
                    Grid.Column="2"
                    Margin="0,24,0,0"
                    Click="OnRefreshScopesClicked"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    Style="{StaticResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <ProgressRing
                            x:Name="ScopeProgressRing"
                            Width="16"
                            Height="16"
                            Visibility="Collapsed"
                            Foreground="{Binding Foreground, ElementName=RefreshScopesButton}"
                            IsActive="False" />
                        <TextBlock Text="读取目录" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Spacing="8">
            <InfoBar x:Name="ErrorInfoBar" IsClosable="True" Severity="Error" />
            <InfoBar x:Name="WarningInfoBar" IsClosable="True" Severity="Warning" />
            <InfoBar
                x:Name="IndexInfoBar"
                IsClosable="False"
                IsOpen="False"
                Severity="Informational"
                Title="当前时间目录尚未建立索引">
                <InfoBar.ActionButton>
                    <Button Click="OnBuildIndexClicked" Content="创建索引" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="292" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border
                Padding="12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid RowSpacing="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="结果范围" />
                        <CheckBox
                            x:Name="ShowInternalCheckBox"
                            Grid.Column="1"
                            Checked="OnShowInternalChanged"
                            Content="内部"
                            Unchecked="OnShowInternalChanged" />
                    </Grid>
                    <TreeView
                        x:Name="ScopeTree"
                        Grid.Row="1"
                        SelectionChanged="OnScopeSelectionChanged" />
                    <TextBlock
                        x:Name="ScopeStatusText"
                        Grid.Row="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="尚未读取结果目录"
                        TextWrapping="Wrap" />
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="3*" />
                    <RowDefinition Height="2*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    Padding="12"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="190" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox
                            x:Name="SectionComboBox"
                            Header="分类"
                            SelectionChanged="OnFilterChanged" />
                        <ComboBox
                            x:Name="UseCaseComboBox"
                            Grid.Column="1"
                            Header="数据用途"
                            SelectionChanged="OnFilterChanged" />
                        <TextBox
                            x:Name="SearchTextBox"
                            Grid.Column="2"
                            Header="搜索"
                            KeyDown="OnSearchKeyDown"
                            PlaceholderText="文件名、用途或说明" />
                        <Button
                            Grid.Column="3"
                            Margin="0,24,0,0"
                            Click="OnApplyFilterClicked"
                            Content="筛选" />
                        <Button
                            x:Name="BuildIndexButton"
                            Grid.Column="4"
                            Margin="0,24,0,0"
                            Click="OnBuildIndexClicked"
                            Content="刷新索引" />
                    </Grid>
                </Border>

                <Border
                    Grid.Row="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="40" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Padding="12,0" ColumnSpacing="10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="42" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="140" />
                            </Grid.ColumnDefinitions>
                            <TextBlock VerticalAlignment="Center" Text="推荐" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="数据用途" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="文件与内容" />
                            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="大小" />
                            <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="修改时间" />
                        </Grid>
                        <ListView
                            x:Name="ResultList"
                            Grid.Row="1"
                            IsItemClickEnabled="False"
                            SelectionChanged="OnResultSelectionChanged"
                            SelectionMode="Extended">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="8" ColumnSpacing="10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="42" />
                                            <ColumnDefinition Width="180" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                            <ColumnDefinition Width="140" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                            Text="{Binding RecommendedDisplay}" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Text="{Binding UseCase}"
                                            TextTrimming="CharacterEllipsis" />
                                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                            <TextBlock FontWeight="SemiBold" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="{Binding Description}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{Binding SizeDisplay}" />
                                        <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{Binding ModifiedDisplay}" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                        <StackPanel
                            x:Name="EmptyResultsPanel"
                            Grid.RowSpan="2"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="6">
                            <FontIcon Glyph="&#xE8A5;" FontSize="28" />
                            <TextBlock x:Name="EmptyResultsText" Text="请选择结果范围" />
                        </StackPanel>
                        <StackPanel x:Name="RecordPager" Grid.Row="2" Orientation="Horizontal"
                                    HorizontalAlignment="Right" Margin="8,4" Spacing="8" Visibility="Collapsed">
                            <TextBlock x:Name="PageRange" VerticalAlignment="Center"/>
                            <Button x:Name="PreviousPageButton" Content="上一页" Click="OnPreviousPageClicked"/>
                            <Button x:Name="NextPageButton" Content="下一页" Click="OnNextPageClicked"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border
                    Grid.Row="2"
                    Padding="14"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="PreviewTitleText" FontSize="16" FontWeight="SemiBold" Text="预览" />
                        <Grid Grid.Row="1" Margin="0,10,0,0">
                            <TextBox
                                x:Name="PreviewTextBox"
                                AcceptsReturn="True"
                                FontFamily="Consolas"
                                IsReadOnly="True"
                                ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                ScrollViewer.VerticalScrollBarVisibility="Auto"
                                Text="选择一个文件后显示预览。"
                                TextWrapping="NoWrap" />
                            <ScrollViewer x:Name="PreviewImageScrollViewer" Visibility="Collapsed" ZoomMode="Enabled">
                                <Image x:Name="PreviewImage" Stretch="Uniform" />
                            </ScrollViewer>
                            <controls:ResultPreviewTable x:Name="PreviewTable" Visibility="Collapsed"/>
                        </Grid>
                    </Grid>
                </Border>

                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar
                            x:Name="IndexProgressBar"
                            Width="180"
                            IsIndeterminate="True"
                            Visibility="Collapsed" />
                        <ProgressBar x:Name="ExportProgressBar" Width="100" Minimum="0" Maximum="100" Visibility="Collapsed" />
                        <TextBlock x:Name="ResultStatusText" Grid.Column="1" VerticalAlignment="Center" Text="就绪" TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <Button
                        x:Name="CancelIndexButton"
                        Grid.Column="1"
                        Click="OnCancelIndexClicked"
                        Content="取消索引"
                        IsEnabled="False" />
                    <Button
                        x:Name="OpenFileButton"
                        Grid.Column="2"
                        Click="OnOpenFileClicked"
                        Content="打开文件"
                        IsEnabled="False" />
                    <Button
                        x:Name="RevealFileButton"
                        Grid.Column="3"
                        Click="OnRevealFileClicked"
                        Content="打开所在文件夹"
                        IsEnabled="False" />
                    <DropDownButton Grid.Column="4" Content="更多">
                        <DropDownButton.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="CopyPathButton" Text="复制路径" Click="OnCopyPathClicked" IsEnabled="False" />
                                <MenuFlyoutItem x:Name="ExportButton" Text="导出所选" Click="OnExportClicked" IsEnabled="False" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Name="RecycleButton" Text="移到回收站" Click="OnRecycleClicked" IsEnabled="False" />
                            </MenuFlyout>
                        </DropDownButton.Flyout>
                    </DropDownButton>
                    <Button x:Name="CancelExportButton" Grid.Column="5" Content="取消导出"
                            Click="OnCancelExportClicked" Visibility="Collapsed" />
                </Grid>
                <Expander x:Name="ExportDetailsExpander" Grid.Row="4" Header="导出记录" Visibility="Collapsed"
                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                    <TextBox x:Name="ExportDetailsText" IsReadOnly="True" AcceptsReturn="True" MaxHeight="150"
                             TextWrapping="NoWrap" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
                </Expander>
            </Grid>
        </Grid>
    </Grid>
</Page>
